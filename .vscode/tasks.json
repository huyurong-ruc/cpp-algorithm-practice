{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build Active C++ File",
      "type": "shell",
      "command": "mkdir -p \"/tmp/cpp-algorithm-practice/${relativeFileDirname}\" && /usr/bin/clang++ -std=c++17 -Wall -Wextra -g \"${file}\" -o \"/tmp/cpp-algorithm-practice/${relativeFileDirname}/${fileBasenameNoExtension}\"",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [
        "$gcc"
      ],
      "detail": "将当前 C++ 文件编译到 /tmp/cpp-algorithm-practice/。"
    }
  ]
}
